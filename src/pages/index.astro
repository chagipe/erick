import Modelos from "../components/Modelos.astro";
import Proceso from "../components/Proceso.astro";
import Nosotros from "../components/Nosotros.astro";
import Contacto from "../components/Contacto.astro";
import Footer from "../components/Footer.astro";
---

<Layout>
  <Navbar />
  <main>
    <Hero />
    <Modelos />
    <Proceso />
    <Nosotros />
    <Contacto />
  </main>
  <Footer />
  <script src="/scripts/main.js" is:inline></script>
</Layout>
