---
interface Props {
  title?: string;
}
const { title = "Erick | Fábrica de Gorras" } = Astro.props;
---

<!DOCTYPE html>
<html lang="es" class="dark">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Archivo+Narrow:wght@400;500;600;700;800&family=Inter:wght@300;400;500;600;700&family=Geist:wght@400;500;600&display=swap"
      rel="stylesheet"
    />
    <link
      href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:opsz,wght,FILL,GRAD@20..48,100..700,0..1,0"
      rel="stylesheet"
    />

    <style is:global>
      @view-transition { navigation: auto; }

      *, *::before, *::after {
        box-sizing: border-box;
      }

      html {
        scroll-behavior: smooth;
      }

      body {
        background: #090909;
        color: #f0ece8;
        font-family: "Inter", sans-serif;
        -webkit-font-smoothing: antialiased;
        -moz-osx-font-smoothing: grayscale;
      }

      ::selection {
        background: rgba(255, 107, 0, 0.3);
        color: #fff;
      }

      ::-webkit-scrollbar {
        width: 5px;
      }
      ::-webkit-scrollbar-track {
        background: #090909;
      }
      ::-webkit-scrollbar-thumb {
        background: #ff6b00;
        border-radius: 0;
      }

      .material-symbols-outlined {
        font-variation-settings: "FILL" 0, "wght" 400, "GRAD" 0, "opsz" 24;
      }

      /* ---------- utilities ---------- */
      .glow-ember {
        box-shadow: 0 0 24px rgba(255, 107, 0, 0.25);
      }
      .glow-ember-strong {
        box-shadow: 0 0 40px rgba(255, 107, 0, 0.35);
      }
      .glow-ember-text {
        text-shadow: 0 0 20px rgba(255, 107, 0, 0.3);
      }

      .mask-fade-right {
        mask-image: linear-gradient(to right, black 60%, transparent 100%);
        -webkit-mask-image: linear-gradient(to right, black 60%, transparent 100%);
      }

      .mask-fade-bottom {
        mask-image: linear-gradient(to top, transparent, black 40%);
        -webkit-mask-image: linear-gradient(to top, transparent, black 40%);
      }

      .grid-pattern {
        background-image:
          linear-gradient(rgba(255, 255, 255, 0.015) 1px, transparent 1px),
          linear-gradient(90deg, rgba(255, 255, 255, 0.015) 1px, transparent 1px);
        background-size: 48px 48px;
      }

      .noise-overlay::after {
        content: "";
        position: absolute;
        inset: 0;
        pointer-events: none;
        opacity: 0.35;
        mix-blend-mode: overlay;
        background-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 256 256' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='n'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='0.9' numOctaves='4' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23n)'/%3E%3C/svg%3E");
        background-repeat: repeat;
        background-size: 256px 256px;
      }

      .line-clamp-2 {
        display: -webkit-box;
        -webkit-line-clamp: 2;
        -webkit-box-orient: vertical;
        overflow: hidden;
      }

      /* ---------- page-load animations ---------- */
      .hero-ready .anim-fade-in {
        animation: fadeIn 0.7s cubic-bezier(0.16, 1, 0.3, 1) both;
      }
      .hero-ready .anim-slide-up {
        animation: slideUp 0.7s cubic-bezier(0.16, 1, 0.3, 1) both;
      }
      .hero-ready .anim-slide-down {
        animation: slideDown 0.7s cubic-bezier(0.16, 1, 0.3, 1) both;
      }
      .hero-ready .anim-scale-in {
        animation: scaleIn 0.8s cubic-bezier(0.16, 1, 0.3, 1) both;
      }
      .hero-ready .anim-zoom-in {
        animation: zoomIn 1s cubic-bezier(0.16, 1, 0.3, 1) both;
      }

      @keyframes fadeIn {
        from { opacity: 0; }
        to { opacity: 1; }
      }
      @keyframes slideUp {
        from { opacity: 0; transform: translateY(30px); }
        to { opacity: 1; transform: translateY(0); }
      }
      @keyframes slideDown {
        from { opacity: 0; transform: translateY(-20px); }
        to { opacity: 1; transform: translateY(0); }
      }
      @keyframes scaleIn {
        from { opacity: 0; transform: scale(0.9); }
        to { opacity: 1; transform: scale(1); }
      }
      @keyframes zoomIn {
        from { opacity: 0; transform: scale(1.08); filter: blur(4px); }
        to { opacity: 1; transform: scale(1); filter: blur(0); }
      }

      @keyframes pulseGlow {
        0%, 100% { opacity: 0.03; transform: translate(-50%, -50%) scale(1); }
        50% { opacity: 0.06; transform: translate(-50%, -50%) scale(1.05); }
      }
      @keyframes floatDown {
        0%, 100% { transform: translateY(0); }
        50% { transform: translateY(4px); }
      }
      .hero-ready .hero-glow {
        animation: pulseGlow 4s ease-in-out infinite;
      }
      .hero-ready .scroll-float {
        animation: floatDown 2s ease-in-out infinite;
      }

      @media (max-width: 1023px) {
        .hero-ready .anim-slide-up,
        .hero-ready .anim-slide-down {
          animation-duration: 0.5s;
        }
        .hero-ready .anim-zoom-in,
        .hero-ready .anim-scale-in {
          animation-duration: 0.6s;
        }
      }

      @media (prefers-reduced-motion: reduce) {
        .hero-ready .anim-fade-in,
        .hero-ready .anim-slide-up,
        .hero-ready .anim-slide-down,
        .hero-ready .anim-scale-in,
        .hero-ready .anim-zoom-in {
          animation: none;
          opacity: 1;
          transform: none;
          filter: none;
        }
        .reveal, .reveal-left, .reveal-right, .reveal-scale {
          transition: none;
          opacity: 1;
          transform: none;
        }
      }

      /* ---------- reveal animations ---------- */
      .reveal {
        opacity: 0;
        transform: translateY(40px);
        transition: opacity 0.8s cubic-bezier(0.16, 1, 0.3, 1),
                    transform 0.8s cubic-bezier(0.16, 1, 0.3, 1);
      }
      .reveal.visible {
        opacity: 1;
        transform: translateY(0);
      }
      .reveal-left {
        opacity: 0;
        transform: translateX(-40px);
        transition: opacity 0.8s cubic-bezier(0.16, 1, 0.3, 1),
                    transform 0.8s cubic-bezier(0.16, 1, 0.3, 1);
      }
      .reveal-left.visible {
        opacity: 1;
        transform: translateX(0);
      }
      .reveal-right {
        opacity: 0;
        transform: translateX(40px);
        transition: opacity 0.8s cubic-bezier(0.16, 1, 0.3, 1),
                    transform 0.8s cubic-bezier(0.16, 1, 0.3, 1);
      }
      .reveal-right.visible {
        opacity: 1;
        transform: translateX(0);
      }
      .reveal-scale {
        opacity: 0;
        transform: scale(0.92);
        transition: opacity 0.8s cubic-bezier(0.16, 1, 0.3, 1),
                    transform 0.8s cubic-bezier(0.16, 1, 0.3, 1);
      }
      .reveal-scale.visible {
        opacity: 1;
        transform: scale(1);
      }

      .stagger-children > * {
        opacity: 0;
        transform: translateY(24px);
      }
      .stagger-children.visible > * {
        animation: staggerFadeIn 0.6s cubic-bezier(0.16, 1, 0.3, 1) forwards;
      }
      .stagger-children.visible > *:nth-child(1) { animation-delay: 0s; }
      .stagger-children.visible > *:nth-child(2) { animation-delay: 0.1s; }
      .stagger-children.visible > *:nth-child(3) { animation-delay: 0.2s; }
      .stagger-children.visible > *:nth-child(4) { animation-delay: 0.3s; }
      .stagger-children.visible > *:nth-child(5) { animation-delay: 0.4s; }

      @keyframes staggerFadeIn {
        to {
          opacity: 1;
          transform: translateY(0);
        }
      }

      /* ---------- page loader ---------- */
      #page-loader {
        transition: opacity 0.5s cubic-bezier(0.16, 1, 0.3, 1),
                    transform 0.5s cubic-bezier(0.16, 1, 0.3, 1),
                    visibility 0s 0.5s;
      }
      #page-loader.loaded {
        opacity: 0;
        transform: translateY(-16px);
        visibility: hidden;
        pointer-events: none;
      }

      #loader-bar {
        transition: width 1.8s cubic-bezier(0.16, 1, 0.3, 1);
      }

      @keyframes loaderPulse {
        0%, 100% { opacity: 0.3; }
        50% { opacity: 1; }
      }
      .loader-dot {
        animation: loaderPulse 1s ease-in-out infinite;
      }
      .loader-dot:nth-child(2) { animation-delay: 0.15s; }
      .loader-dot:nth-child(3) { animation-delay: 0.3s; }

      @media (prefers-reduced-motion: reduce) {
        #page-loader {
          transition: opacity 0.3s ease, visibility 0s 0.3s;
        }
        #loader-bar {
          transition: none;
        }
        .loader-dot {
          animation: none;
          opacity: 0.5;
        }
      }
    </style>
  </head>
  <body>
    <!-- Page loader -->
    <div
      id="page-loader"
      class="fixed inset-0 z-[999] bg-ink flex flex-col items-center justify-center"
    >
      <div class="text-center">
        <div
          class="font-display text-[clamp(2rem,6vw,5rem)] font-bold text-lead uppercase tracking-[-0.03em] leading-none"
        >
          ERICK
        </div>
        <div
          class="text-[0.55rem] font-mono uppercase tracking-[0.2em] text-smoke/40 mt-1.5"
        >
          Fábrica de Gorras
        </div>
        <div class="mt-6 w-36 h-[1px] bg-white/5 relative overflow-hidden mx-auto">
          <div id="loader-bar" class="absolute inset-0 bg-ember" style="width: 0%"></div>
        </div>
      </div>
    </div>

    <slot />
  </body>
</html>
