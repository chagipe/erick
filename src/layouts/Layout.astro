---
interface Props {
  title?: string;
}
const { title = "ERICK — Colección de Gorras" } = Astro.props;
---

<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>{title}</title>
  <script src="https://cdn.tailwindcss.com"></script>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800;900&display=swap" rel="stylesheet">
  <script>
    tailwind.config = {
      theme: {
        extend: {
          fontFamily: {
            sans: ['Inter', 'sans-serif'],
          },
          colors: {
            erick: {
              black: '#111111',
              gray: '#F9F9F9',
              dark: '#1a1a1a',
            }
          },
          letterSpacing: {
            widest: '0.15em',
            wide: '0.08em',
          }
        }
      }
    }
  </script>
  <style is:global>
    * { margin: 0; padding: 0; box-sizing: border-box; }
    body { font-family: 'Inter', sans-serif; -webkit-font-smoothing: antialiased; }

    .announcement-bar {
      background: #111111;
      color: #ffffff;
      font-size: 11px;
      letter-spacing: 0.1em;
      text-transform: uppercase;
    }

    .header-icon {
      transition: opacity 0.2s ease;
    }
    .header-icon:hover {
      opacity: 0.7;
    }

    .sort-dropdown {
      display: none;
      position: absolute;
      top: 100%;
      right: 0;
      min-width: 220px;
      background: #fff;
      border: 1px solid #e5e5e5;
      box-shadow: 0 8px 24px rgba(0,0,0,0.08);
      z-index: 40;
    }
    .sort-dropdown.open {
      display: block;
    }
    .sort-dropdown button {
      width: 100%;
      text-align: left;
      padding: 10px 16px;
      font-size: 12px;
      letter-spacing: 0.05em;
      color: #111;
      transition: background 0.15s;
    }
    .sort-dropdown button:hover {
      background: #f5f5f5;
    }

    .floating-offer {
      position: fixed;
      right: 0;
      top: 50%;
      transform: translateY(-50%);
      z-index: 45;
      writing-mode: vertical-rl;
      text-orientation: mixed;
    }

    .whatsapp-float {
      position: fixed;
      bottom: 24px;
      right: 24px;
      z-index: 50;
      width: 56px;
      height: 56px;
      border-radius: 50%;
      background: #000000;
      display: flex;
      align-items: center;
      justify-content: center;
      box-shadow: 0 10px 25px -5px rgba(0, 0, 0, 0.4), 0 8px 10px -6px rgba(0, 0, 0, 0.3);
      transition: transform 0.2s ease, box-shadow 0.2s ease;
    }
    .whatsapp-float:hover {
      transform: scale(1.08);
      box-shadow: 0 14px 30px -5px rgba(0, 0, 0, 0.5), 0 10px 14px -6px rgba(0, 0, 0, 0.35);
    }
    @media (max-width: 768px) {
      .whatsapp-float {
        bottom: 16px;
        right: 16px;
        width: 50px;
        height: 50px;
      }
      .floating-offer {
        display: none;
      }
    }

    .product-card .product-img {
      transition: transform 0.5s cubic-bezier(0.25, 0.46, 0.45, 0.94), opacity 0.4s ease;
    }
    .product-card:hover .product-img {
      transform: scale(1.05);
    }
    .product-card .product-img-secondary {
      opacity: 0;
      transition: opacity 0.4s ease;
      position: absolute;
      inset: 0;
    }
    .product-card:hover .product-img-secondary {
      opacity: 1;
    }

    .filter-btn {
      transition: all 0.3s ease;
    }
    .filter-btn.active {
      background: #111111;
      color: #ffffff;
      border-color: #111111;
    }

    .badge {
      font-size: 9px;
      letter-spacing: 0.12em;
      text-transform: uppercase;
    }

    .nav-link {
      position: relative;
    }
    .nav-link::after {
      content: '';
      position: absolute;
      bottom: -2px;
      left: 0;
      width: 0;
      height: 1px;
      background: #111111;
      transition: width 0.3s ease;
    }
    .nav-link:hover::after {
      width: 100%;
    }

    .btn-primary {
      transition: all 0.3s ease;
    }
    .btn-primary:hover {
      background: #333333;
      transform: translateY(-1px);
    }

    .mobile-menu {
      transform: translateX(100%);
      transition: transform 0.35s cubic-bezier(0.25, 0.46, 0.45, 0.94);
    }
    .mobile-menu.open {
      transform: translateX(0);
    }

    .hero-banner {
      background: linear-gradient(135deg, #f5f5f5 0%, #ffffff 50%, #f5f5f5 100%);
    }

    .fade-in {
      opacity: 0;
      transform: translateY(20px);
      transition: opacity 0.6s ease, transform 0.6s ease;
    }
    .fade-in.visible {
      opacity: 1;
      transform: translateY(0);
    }

    .form-input:focus {
      outline: none;
      border-color: #111111;
      box-shadow: 0 0 0 1px #111111;
    }

    ::-webkit-scrollbar { width: 8px; }
    ::-webkit-scrollbar-track { background: #f1f1f1; }
    ::-webkit-scrollbar-thumb { background: #ccc; border-radius: 4px; }
    ::-webkit-scrollbar-thumb:hover { background: #999; }
  </style>
</head>
<body class="bg-white text-[#111111]">
  <slot />
</body>
</html>