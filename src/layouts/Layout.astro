---
interface Props {
  title?: string;
}
const { title = "Erick | Fábrica de Gorras" } = Astro.props;
---

<!DOCTYPE html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Archivo+Narrow:wght@400;500;600;700;800&family=Inter:wght@300;400;500;600;700&family=Geist:wght@400;500;600&display=swap"
      rel="stylesheet"
    />
    <link
      href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:opsz,wght,FILL,GRAD@20..48,100..700,0..1,0"
      rel="stylesheet"
    />

    <style is:global>
      @view-transition { navigation: auto; }

      *, *::before, *::after {
        box-sizing: border-box;
      }

      html {
        scroll-behavior: smooth;
      }

      /* ─── Theme CSS Variables ─── */
      :root {
        --ink: #F5F1EC;
        --lead: #1C1816;
        --iron: #EDE8E3;
        --slag: rgba(28,24,22,0.08);
        --ember: #E31837;
        --emberlight: #FF4D6D;
        --emberdark: #B8152B;
        --brass: #1C1816;
        --brassdark: #000000;
        --smoke: #9C958E;
        --soot: #6B6560;
        --graphite: #E5E0DB;
        --ash: #D6D1CC;
        --glass: rgba(255,255,255,0.55);
        --glass-border: rgba(255,255,255,0.75);
        --glass-shadow: rgba(28,24,22,0.04);
      }

      .dark {
        --ink: #0C0A0A;
        --lead: #F0ECE8;
        --iron: #181514;
        --slag: rgba(240,236,232,0.06);
        --ember: #E31837;
        --emberlight: #FF4D6D;
        --emberdark: #B8152B;
        --brass: #F0ECE8;
        --brassdark: #FFFFFF;
        --smoke: #5A5550;
        --soot: #8A8580;
        --graphite: #22201E;
        --ash: #2D2A28;
        --glass: rgba(255,255,255,0.035);
        --glass-border: rgba(255,255,255,0.07);
        --glass-shadow: rgba(0,0,0,0.4);
      }

      body {
        background: var(--ink);
        color: var(--lead);
        font-family: "Inter", sans-serif;
        -webkit-font-smoothing: antialiased;
        -moz-osx-font-smoothing: grayscale;
        transition: background 0.35s ease, color 0.35s ease;
      }

      ::selection {
        background: rgba(227, 24, 55, 0.15);
        color: var(--lead);
      }

      ::-webkit-scrollbar {
        width: 5px;
      }
      ::-webkit-scrollbar-track {
        background: var(--iron);
      }
      ::-webkit-scrollbar-thumb {
        background: var(--ember);
        border-radius: 0;
      }

      .material-symbols-outlined {
        font-variation-settings: "FILL" 0, "wght" 400, "GRAD" 0, "opsz" 24;
      }

      /* ─── Section number styling (AI Report inspired) ─── */
      .section-number {
        font-family: "Archivo Narrow", sans-serif;
        font-size: clamp(5rem, 15vw, 10rem);
        font-weight: 800;
        line-height: 0.85;
        letter-spacing: -0.06em;
        user-select: none;
        transition: color 0.35s ease;
        position: absolute;
        top: -0.15em;
        right: 0;
        opacity: 0.04;
        pointer-events: none;
      }

      .section-number.flipped {
        right: auto;
        left: 0;
      }

      .section-label {
        font-family: "Geist", monospace;
        font-size: 0.7rem;
        font-weight: 500;
        letter-spacing: 0.2em;
        text-transform: uppercase;
        transition: color 0.35s ease;
      }

      /* ─── Big stat number ─── */
      .stat-number {
        font-family: "Archivo Narrow", sans-serif;
        font-size: clamp(2.5rem, 5vw, 4rem);
        font-weight: 800;
        line-height: 1;
        letter-spacing: -0.03em;
        transition: color 0.35s ease;
      }

      /* ─── Better accent line ─── */
      .accent-line {
        width: 32px;
        height: 3px;
        border-radius: 2px;
        transition: background 0.35s ease;
      }

      /* ─── Glass + Bento utilities ─── */
      .glass-card {
        background: var(--glass);
        backdrop-filter: blur(20px);
        -webkit-backdrop-filter: blur(20px);
        border: 1px solid var(--glass-border);
        border-radius: 20px;
        box-shadow: 0 4px 24px var(--glass-shadow);
        transition: box-shadow 0.4s ease, transform 0.4s ease, background 0.35s ease, border 0.35s ease;
      }

      .glass-card:hover {
        box-shadow: 0 8px 40px var(--glass-shadow);
        transform: translateY(-3px);
      }

      .glass-card-static {
        background: var(--glass);
        backdrop-filter: blur(20px);
        -webkit-backdrop-filter: blur(20px);
        border: 1px solid var(--glass-border);
        border-radius: 20px;
        box-shadow: 0 4px 24px var(--glass-shadow);
        transition: background 0.35s ease, border 0.35s ease;
      }

      .bento-glass {
        background: var(--glass);
        backdrop-filter: blur(20px);
        -webkit-backdrop-filter: blur(20px);
        border: 1px solid var(--glass-border);
        border-radius: 20px;
        overflow: hidden;
        box-shadow: 0 4px 24px var(--glass-shadow);
        transition: box-shadow 0.4s ease, transform 0.4s ease, background 0.35s ease, border 0.35s ease;
      }

      .bento-glass:hover {
        box-shadow: 0 8px 40px var(--glass-shadow);
        transform: translateY(-3px);
      }

      .glow-ember {
        box-shadow: 0 0 24px rgba(227, 24, 55, 0.2);
      }

      .mask-fade-bottom {
        mask-image: linear-gradient(to top, transparent, black 40%);
        -webkit-mask-image: linear-gradient(to top, transparent, black 40%);
      }

      /* ─── Theme toggle button ─── */
      .theme-toggle {
        width: 40px;
        height: 40px;
        border-radius: 50%;
        border: 1px solid var(--slag);
        background: var(--glass);
        backdrop-filter: blur(12px);
        color: var(--soot);
        cursor: pointer;
        display: flex;
        align-items: center;
        justify-content: center;
        transition: all 0.3s ease;
        font-size: 1.15rem;
      }

      .theme-toggle:hover {
        border-color: var(--ember);
        color: var(--ember);
      }

      /* ─── Page load animations ─── */
      .hero-ready .anim-fade-in {
        animation: fadeIn 0.7s cubic-bezier(0.16, 1, 0.3, 1) both;
      }
      .hero-ready .anim-slide-up {
        animation: slideUp 0.7s cubic-bezier(0.16, 1, 0.3, 1) both;
      }
      .hero-ready .anim-slide-down {
        animation: slideDown 0.7s cubic-bezier(0.16, 1, 0.3, 1) both;
      }
      .hero-ready .anim-scale-in {
        animation: scaleIn 0.8s cubic-bezier(0.16, 1, 0.3, 1) both;
      }
      .hero-ready .anim-zoom-in {
        animation: zoomIn 1s cubic-bezier(0.16, 1, 0.3, 1) both;
      }

      @keyframes fadeIn {
        from { opacity: 0; }
        to { opacity: 1; }
      }
      @keyframes slideUp {
        from { opacity: 0; transform: translateY(30px); }
        to { opacity: 1; transform: translateY(0); }
      }
      @keyframes slideDown {
        from { opacity: 0; transform: translateY(-20px); }
        to { opacity: 1; transform: translateY(0); }
      }
      @keyframes scaleIn {
        from { opacity: 0; transform: scale(0.9); }
        to { opacity: 1; transform: scale(1); }
      }
      @keyframes zoomIn {
        from { opacity: 0; transform: scale(1.08); filter: blur(4px); }
        to { opacity: 1; transform: scale(1); filter: blur(0); }
      }

      @keyframes pulseGlow {
        0%, 100% { opacity: 0.03; transform: translate(-50%, -50%) scale(1); }
        50% { opacity: 0.06; transform: translate(-50%, -50%) scale(1.05); }
      }
      @keyframes floatDown {
        0%, 100% { transform: translateY(0); }
        50% { transform: translateY(4px); }
      }
      .hero-ready .hero-glow {
        animation: pulseGlow 4s ease-in-out infinite;
      }
      .hero-ready .scroll-float {
        animation: floatDown 2s ease-in-out infinite;
      }

      @media (max-width: 1023px) {
        .hero-ready .anim-slide-up,
        .hero-ready .anim-slide-down {
          animation-duration: 0.5s;
        }
        .hero-ready .anim-zoom-in,
        .hero-ready .anim-scale-in {
          animation-duration: 0.6s;
        }
      }

      @media (prefers-reduced-motion: reduce) {
        .hero-ready .anim-fade-in,
        .hero-ready .anim-slide-up,
        .hero-ready .anim-slide-down,
        .hero-ready .anim-scale-in,
        .hero-ready .anim-zoom-in {
          animation: none;
          opacity: 1;
          transform: none;
          filter: none;
        }
        .reveal, .reveal-left, .reveal-right, .reveal-scale {
          transition: none;
          opacity: 1;
          transform: none;
        }
      }

      /* ─── Reveal animations ─── */
      .reveal {
        opacity: 0;
        transform: translateY(40px);
        transition: opacity 0.8s cubic-bezier(0.16, 1, 0.3, 1),
                    transform 0.8s cubic-bezier(0.16, 1, 0.3, 1);
      }
      .reveal.visible {
        opacity: 1;
        transform: translateY(0);
      }
      .reveal-left {
        opacity: 0;
        transform: translateX(-40px);
        transition: opacity 0.8s cubic-bezier(0.16, 1, 0.3, 1),
                    transform 0.8s cubic-bezier(0.16, 1, 0.3, 1);
      }
      .reveal-left.visible {
        opacity: 1;
        transform: translateX(0);
      }
      .reveal-right {
        opacity: 0;
        transform: translateX(40px);
        transition: opacity 0.8s cubic-bezier(0.16, 1, 0.3, 1),
                    transform 0.8s cubic-bezier(0.16, 1, 0.3, 1);
      }
      .reveal-right.visible {
        opacity: 1;
        transform: translateX(0);
      }
      .reveal-scale {
        opacity: 0;
        transform: scale(0.92);
        transition: opacity 0.8s cubic-bezier(0.16, 1, 0.3, 1),
                    transform 0.8s cubic-bezier(0.16, 1, 0.3, 1);
      }
      .reveal-scale.visible {
        opacity: 1;
        transform: scale(1);
      }

      .stagger-children > * {
        opacity: 0;
        transform: translateY(24px);
      }
      .stagger-children.visible > * {
        animation: staggerFadeIn 0.6s cubic-bezier(0.16, 1, 0.3, 1) forwards;
      }
      .stagger-children.visible > *:nth-child(1) { animation-delay: 0s; }
      .stagger-children.visible > *:nth-child(2) { animation-delay: 0.1s; }
      .stagger-children.visible > *:nth-child(3) { animation-delay: 0.2s; }
      .stagger-children.visible > *:nth-child(4) { animation-delay: 0.3s; }
      .stagger-children.visible > *:nth-child(5) { animation-delay: 0.4s; }

      @keyframes staggerFadeIn {
        to {
          opacity: 1;
          transform: translateY(0);
        }
      }

      /* ─── Page loader ─── */
      #page-loader {
        transition: opacity 0.5s cubic-bezier(0.16, 1, 0.3, 1),
                    transform 0.5s cubic-bezier(0.16, 1, 0.3, 1),
                    visibility 0s 0.5s,
                    background 0.35s ease;
      }
      #page-loader.loaded {
        opacity: 0;
        transform: translateY(-16px);
        visibility: hidden;
        pointer-events: none;
      }
      #loader-bar {
        transition: width 1.8s cubic-bezier(0.16, 1, 0.3, 1);
      }

      @keyframes loaderPulse {
        0%, 100% { opacity: 0.3; }
        50% { opacity: 1; }
      }
      .loader-dot {
        animation: loaderPulse 1s ease-in-out infinite;
      }
      .loader-dot:nth-child(2) { animation-delay: 0.15s; }
      .loader-dot:nth-child(3) { animation-delay: 0.3s; }

      @media (prefers-reduced-motion: reduce) {
        #page-loader {
          transition: opacity 0.3s ease, visibility 0s 0.3s;
        }
        #loader-bar {
          transition: none;
        }
        .loader-dot {
          animation: none;
          opacity: 0.5;
        }
      }
    </style>
  </head>
  <body>
    <!-- Page loader -->
    <div
      id="page-loader"
      class="fixed inset-0 z-[999] flex flex-col items-center justify-center"
      style="background: var(--ink)"
    >
      <div class="text-center">
        <div
          class="font-display text-[clamp(2rem,6vw,5rem)] font-bold uppercase tracking-[-0.03em] leading-none"
          style="color: var(--lead)"
        >
          ERICK
        </div>
        <div
          class="text-[0.55rem] font-mono uppercase tracking-[0.2em] mt-1.5"
          style="color: var(--smoke)"
        >
          Fábrica de Gorras
        </div>
        <div class="mt-6 w-36 h-[2px] relative overflow-hidden mx-auto" style="background: var(--slag)">
          <div id="loader-bar" class="absolute inset-0" style="background: var(--ember); width: 0%"></div>
        </div>
      </div>
    </div>

    <slot />
  </body>
</html>
