<section id="modelos" class="relative py-section overflow-hidden" style="background: var(--iron)">
  <div class="absolute inset-0 opacity-[0.015]" style="background-image: radial-gradient(var(--lead) 1px, transparent 1px); background-size: 32px 32px;"></div>
  <div class="section-number" style="color: var(--lead)">01</div>

  <div class="mx-auto px-gutter relative z-10" style="max-width: 1400px">
    <div class="flex flex-col lg:flex-row lg:items-end justify-between gap-6 mb-16 lg:mb-20">
      <div class="reveal">
        <span class="section-label block mb-3 reveal" style="color: var(--ember)">Catálogo 2026</span>
        <h2 class="font-display uppercase leading-[0.92] m-0" style="color: var(--lead); font-size: clamp(2.5rem, 6vw, 5rem)">
          Modelos<br />Disponibles
        </h2>
      </div>
      <p class="text-body-md max-w-xs lg:text-right reveal" style="transition-delay: 0.1s; color: var(--smoke)">
        Lote mínimo: 30 unidades. Todos admiten personalización total.
      </p>
    </div>

    <!-- Bento grid balanceado -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-12 gap-5">
      <!-- Trucker — más ancho -->
      <div class="md:col-span-2 lg:col-span-7 group cursor-pointer reveal-scale bento-glass">
        <div class="relative h-full">
          <div class="aspect-[4/3] lg:aspect-[16/9] overflow-hidden">
            <img class="w-full h-full object-cover transition-all duration-700 group-hover:scale-105"
              src="https://images.unsplash.com/photo-1588850561407-ed78c282e89b?w=600&q=80"
              alt="Trucker Hat" loading="lazy" />
            <div class="absolute inset-0" style="background: linear-gradient(to top, rgba(0,0,0,0.5) 0%, transparent 40%);"></div>
          </div>
          <div class="absolute bottom-0 left-0 right-0 p-6 flex justify-between items-end">
            <div>
              <span class="text-[0.55rem] font-mono uppercase tracking-[0.2em] text-white px-2 py-1 inline-block mb-2 rounded" style="background: var(--ember)">Más pedido</span>
              <h3 class="font-display text-heading-lg text-white uppercase m-0 leading-none">Trucker</h3>
              <p class="text-[0.8rem] text-white/60 mt-1 m-0">Malla · Frente Rígido</p>
            </div>
            <span class="text-white/40 font-mono text-[0.7rem] uppercase tracking-[0.15em]">$120</span>
          </div>
        </div>
      </div>

      <!-- Snapback -->
      <div class="lg:col-span-5 group cursor-pointer reveal-scale bento-glass" style="transition-delay: 0.1s">
        <div class="relative h-full">
          <div class="aspect-[4/3] lg:aspect-[4/5] overflow-hidden">
            <img class="w-full h-full object-cover transition-all duration-700 group-hover:scale-105"
              src="https://images.unsplash.com/photo-1556306535-0f09a537f0a3?w=600&q=80"
              alt="Snapback premium" loading="lazy" />
            <div class="absolute inset-0" style="background: linear-gradient(to top, rgba(0,0,0,0.5) 0%, transparent 40%);"></div>
          </div>
          <div class="absolute bottom-0 left-0 right-0 p-6 flex justify-between items-end">
            <div>
              <h3 class="font-display text-heading-md text-white uppercase m-0 leading-none">Snapback</h3>
              <p class="text-[0.8rem] text-white/60 mt-1 m-0">Visera Plana · Ajustable</p>
            </div>
            <span class="text-white/40 font-mono text-[0.7rem] uppercase tracking-[0.15em]">$135</span>
          </div>
        </div>
      </div>

      <!-- Dad Hat -->
      <div class="lg:col-span-5 group cursor-pointer reveal-scale bento-glass" style="transition-delay: 0.2s">
        <div class="relative h-full">
          <div class="aspect-[4/3] lg:aspect-[4/5] overflow-hidden">
            <img class="w-full h-full object-cover transition-all duration-700 group-hover:scale-105"
              src="https://images.unsplash.com/photo-1534215754734-18e55d13e346?w=600&q=80"
              alt="Dad Hat" loading="lazy" />
            <div class="absolute inset-0" style="background: linear-gradient(to top, rgba(0,0,0,0.5) 0%, transparent 40%);"></div>
          </div>
          <div class="absolute bottom-0 left-0 right-0 p-6 flex justify-between items-end">
            <div>
              <h3 class="font-display text-heading-md text-white uppercase m-0 leading-none">Dad Hat</h3>
              <p class="text-[0.8rem] text-white/60 mt-1 m-0">Curvo · Algodón Pre-lavado</p>
            </div>
            <span class="text-white/40 font-mono text-[0.7rem] uppercase tracking-[0.15em]">$110</span>
          </div>
        </div>
      </div>

      <!-- Beanie — más ancho -->
      <div class="md:col-span-2 lg:col-span-7 group cursor-pointer reveal-scale bento-glass" style="transition-delay: 0.3s">
        <div class="relative h-full">
          <div class="aspect-[4/3] lg:aspect-[16/9] overflow-hidden">
            <img class="w-full h-full object-cover transition-all duration-700 group-hover:scale-105"
              src="https://images.unsplash.com/photo-1576871337632-b9aef4c17ab9?w=600&q=80"
              alt="Beanie térmico" loading="lazy" />
            <div class="absolute inset-0" style="background: linear-gradient(to top, rgba(0,0,0,0.5) 0%, transparent 40%);"></div>
          </div>
          <div class="absolute bottom-0 left-0 right-0 p-6 flex justify-between items-end">
            <div>
              <span class="text-[0.55rem] font-mono uppercase tracking-[0.2em] px-2 py-1 inline-block mb-2 rounded" style="color: var(--lead); background: var(--glass)">Nueva temporada</span>
              <h3 class="font-display text-heading-lg text-white uppercase m-0 leading-none">Beanies</h3>
              <p class="text-[0.8rem] text-white/60 mt-1 m-0">Tejido Térmico · Doble Capa</p>
            </div>
            <span class="text-white/40 font-mono text-[0.7rem] uppercase tracking-[0.15em]">$95</span>
          </div>
        </div>
      </div>
    </div>

    <div class="mt-12 text-center reveal">
      <a href="#contacto"
        class="inline-flex items-center gap-2 text-[0.75rem] font-mono uppercase tracking-[0.15em] no-underline transition-colors duration-300"
        style="color: var(--smoke)"
        onmouseover="this.style.color='var(--ember)'" onmouseout="this.style.color='var(--smoke)'">
        Ver catálogo completo
        <span class="material-symbols-outlined text-base">arrow_forward</span>
      </a>
    </div>
  </div>
</section>