<section id="modelos" class="relative py-section overflow-hidden">
  <div class="mx-auto px-gutter" style="max-width: 1400px">
    <!-- Header -->
    <div class="flex flex-col lg:flex-row lg:items-end justify-between gap-6 mb-12 lg:mb-16">
      <div class="reveal">
        <span
          class="text-[0.65rem] font-mono uppercase tracking-[0.2em] text-ember block mb-3"
        >
          Catálogo 2026
        </span>
        <h2
          class="font-display text-display-lg text-lead uppercase leading-[0.95] m-0"
        >
          Modelos<br />Disponibles
        </h2>
      </div>
      <p
        class="text-body-md text-smoke/50 max-w-xs lg:text-right reveal"
        style="transition-delay: 0.1s"
      >
        Lote mínimo por diseño: 30 unidades. Todos nuestros modelos admiten
        personalización total.
      </p>
    </div>

    <!-- Grid editorial -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-12 gap-4 lg:gap-5">
      <!-- Card 1: Trucker — destacado, ocupa más espacio -->
      <div
        class="md:col-span-2 lg:col-span-7 row-span-1 group cursor-pointer reveal-scale"
      >
        <div class="relative h-full bg-iron overflow-hidden border border-white/5">
          <div class="aspect-[4/3] lg:aspect-[16/10] overflow-hidden">
            <img
              class="w-full h-full object-cover transition-all duration-700 group-hover:scale-105"
              src="https://images.unsplash.com/photo-1588850561407-ed78c282e89b?w=600&q=80"
              alt="Trucker Hat con malla trasera"
              loading="lazy"
            />
            <div class="absolute inset-0 bg-gradient-to-t from-ink via-ink/20 to-transparent"></div>
          </div>
          <div
            class="absolute bottom-0 left-0 right-0 p-5 lg:p-6 flex justify-between items-end"
          >
            <div>
              <span
                class="text-[0.55rem] font-mono uppercase tracking-[0.2em] text-ember bg-ember/10 px-2 py-1 inline-block mb-2"
              >
                Más pedido
              </span>
              <h3
                class="font-display text-heading-lg text-lead uppercase m-0 leading-none"
              >
                Trucker
              </h3>
              <p class="text-[0.8rem] text-smoke/60 mt-1 m-0">
                Malla | Frente Rígido
              </p>
            </div>
            <span
              class="text-smoke/30 font-mono text-[0.7rem] uppercase tracking-[0.15em]"
            >
              desde $120
            </span>
          </div>
        </div>
      </div>

      <!-- Card 2: Snapback -->
      <div
        class="lg:col-span-5 group cursor-pointer reveal-scale"
        style="transition-delay: 0.1s"
      >
        <div class="relative h-full bg-iron overflow-hidden border border-white/5">
          <div class="aspect-[4/3] lg:aspect-[4/5] overflow-hidden">
            <img
              class="w-full h-full object-cover transition-all duration-700 group-hover:scale-105"
              src="https://images.unsplash.com/photo-1556306535-0f09a537f0a3?w=600&q=80"
              alt="Snapback premium"
              loading="lazy"
            />
            <div class="absolute inset-0 bg-gradient-to-t from-ink via-ink/10 to-transparent"></div>
          </div>
          <div
            class="absolute bottom-0 left-0 right-0 p-5 lg:p-6 flex justify-between items-end"
          >
            <div>
              <h3
                class="font-display text-heading-md text-lead uppercase m-0 leading-none"
              >
                Snapback
              </h3>
              <p class="text-[0.8rem] text-smoke/60 mt-1 m-0">
                Visera Plana | Ajustable
              </p>
            </div>
            <span
              class="text-smoke/30 font-mono text-[0.7rem] uppercase tracking-[0.15em]"
            >
              desde $135
            </span>
          </div>
        </div>
      </div>

      <!-- Card 3: Dad Hat -->
      <div
        class="lg:col-span-5 group cursor-pointer reveal-scale"
        style="transition-delay: 0.2s"
      >
        <div class="relative h-full bg-iron overflow-hidden border border-white/5">
          <div class="aspect-[4/3] lg:aspect-[4/5] overflow-hidden">
            <img
              class="w-full h-full object-cover transition-all duration-700 group-hover:scale-105"
              src="https://images.unsplash.com/photo-1534215754734-18e55d13e346?w=600&q=80"
              alt="Dad Hat de algodón pre-lavado"
              loading="lazy"
            />
            <div class="absolute inset-0 bg-gradient-to-t from-ink via-ink/10 to-transparent"></div>
          </div>
          <div
            class="absolute bottom-0 left-0 right-0 p-5 lg:p-6 flex justify-between items-end"
          >
            <div>
              <h3
                class="font-display text-heading-md text-lead uppercase m-0 leading-none"
              >
                Dad Hat
              </h3>
              <p class="text-[0.8rem] text-smoke/60 mt-1 m-0">
                Curvo | Algodón Pre-lavado
              </p>
            </div>
            <span
              class="text-smoke/30 font-mono text-[0.7rem] uppercase tracking-[0.15em]"
            >
              desde $110
            </span>
          </div>
        </div>
      </div>

      <!-- Card 4: Beanie -->
      <div
        class="md:col-span-2 lg:col-span-7 group cursor-pointer reveal-scale"
        style="transition-delay: 0.3s"
      >
        <div class="relative h-full bg-iron overflow-hidden border border-white/5">
          <div class="aspect-[4/3] lg:aspect-[16/10] overflow-hidden">
            <img
              class="w-full h-full object-cover transition-all duration-700 group-hover:scale-105"
              src="https://images.unsplash.com/photo-1576871337632-b9aef4c17ab9?w=600&q=80"
              alt="Beanie térmico"
              loading="lazy"
            />
            <div class="absolute inset-0 bg-gradient-to-t from-ink via-ink/20 to-transparent"></div>
          </div>
          <div
            class="absolute bottom-0 left-0 right-0 p-5 lg:p-6 flex justify-between items-end"
          >
            <div>
              <span
                class="text-[0.55rem] font-mono uppercase tracking-[0.2em] text-brass bg-brass/10 px-2 py-1 inline-block mb-2"
              >
                Nueva temporada
              </span>
              <h3
                class="font-display text-heading-lg text-lead uppercase m-0 leading-none"
              >
                Beanies
              </h3>
              <p class="text-[0.8rem] text-smoke/60 mt-1 m-0">
                Tejido Térmico | Doble Capa
              </p>
            </div>
            <span
              class="text-smoke/30 font-mono text-[0.7rem] uppercase tracking-[0.15em]"
            >
              desde $95
            </span>
          </div>
        </div>
      </div>
    </div>

    <!-- CTA -->
    <div class="mt-10 text-center reveal">
      <a
        href="#contacto"
        class="inline-flex items-center gap-2 text-[0.75rem] font-mono uppercase tracking-[0.15em] text-smoke no-underline hover:text-ember transition-colors duration-300"
      >
        Ver catálogo completo
        <span class="material-symbols-outlined text-base">arrow_forward</span>
      </a>
    </div>
  </div>
</section>
