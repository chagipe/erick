<section id="hero" class="relative min-h-screen flex items-center overflow-hidden">
  <!-- Background -->
  <div class="absolute inset-0 bg-ink">
    <div class="absolute inset-0 grid-pattern opacity-40"></div>
    <div class="absolute inset-0 noise-overlay"></div>
    <div
      class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[800px] h-[800px] rounded-full bg-ember/3 blur-[120px] hero-glow"
    ></div>
  </div>

  <div
    class="relative z-10 w-full mx-auto px-gutter pt-24 pb-16"
    style="max-width: 1400px"
  >
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 lg:gap-16 items-center">
      <!-- Copy -->
      <div class="lg:col-span-7">
        <span
          class="inline-flex items-center gap-2 text-[0.65rem] font-mono uppercase tracking-[0.2em] text-ember bg-ember/8 border border-ember/20 px-3 py-1.5 mb-6 anim-slide-down"
          style="animation-delay: 0.05s"
        >
          <span class="w-1.5 h-1.5 rounded-full bg-ember animate-pulse"></span>
          Fundada 2026 · Producción Industrial
        </span>

        <h1
          class="font-display text-display-xl text-lead uppercase leading-[0.92] mt-0 mb-0"
        >
          <span class="block anim-slide-up" style="animation-delay: 0.12s">Fabricamos</span>
          <span class="block text-ember glow-ember-text anim-slide-up" style="animation-delay: 0.22s">Identidad</span>
          <span class="block anim-slide-up" style="animation-delay: 0.32s">desde 0.</span>
        </h1>

        <p
          class="mt-6 text-body-lg text-soot/70 max-w-[520px] leading-relaxed anim-fade-in"
          style="animation-delay: 0.45s"
        >
          Producimos gorras con obsesión por el detalle. Materiales de grado
          industrial, costura reforzada en cada punto de tensión y control de
          calidad unitario. De tu visión a tu lote, sin intermediarios.
        </p>

        <div class="flex flex-col sm:flex-row gap-4 mt-8 anim-slide-up" style="animation-delay: 0.6s">
          <a
            href="#contacto"
            class="group inline-flex items-center gap-3 bg-ember text-ink font-semibold text-[0.85rem] uppercase tracking-[0.08em] px-7 py-3.5 no-underline hover:bg-emberlight transition-all duration-300"
          >
            Iniciar proyecto
            <span
              class="material-symbols-outlined text-lg transition-transform duration-300 group-hover:translate-x-1"
            >
              arrow_forward
            </span>
          </a>
          <a
            href="#modelos"
            class="inline-flex items-center gap-2 border border-smoke/30 text-lead/80 text-[0.85rem] uppercase tracking-[0.08em] px-7 py-3.5 no-underline hover:border-ember hover:text-ember transition-all duration-300"
          >
            <span class="w-5 h-[1px] bg-current"></span>
            Explorar modelos
          </a>
        </div>

        <!-- Trusted by -->
        <div class="mt-12 pt-8 border-t border-white/5 anim-fade-in" style="animation-delay: 0.75s">
          <p
            class="text-[0.6rem] font-mono uppercase tracking-[0.2em] text-smoke/50 mb-4"
          >
            Confían en nosotros
          </p>
          <div class="flex flex-wrap gap-8 items-center">
            <span class="text-smoke/30 font-display text-[1.2rem] font-bold uppercase tracking-tight">Marca+</span>
            <span class="text-smoke/30 font-display text-[1.2rem] font-bold uppercase tracking-tight">RUSH</span>
            <span class="text-smoke/30 font-display text-[1.2rem] font-bold uppercase tracking-tight">STREET</span>
            <span class="text-smoke/30 font-display text-[1.2rem] font-bold uppercase tracking-tight">RAW</span>
          </div>
        </div>
      </div>

      <!-- Visual panel -->
      <div class="lg:col-span-5 relative">
        <div class="relative">
          <!-- Main image -->
          <div class="relative overflow-hidden bg-iron anim-zoom-in" style="animation-delay: 0.15s">
            <img
              class="w-full h-[420px] lg:h-[580px] object-cover opacity-90 hover:opacity-100 transition-opacity duration-700"
              src="https://static.nike.com/a/images/t_web_pdp_535_v2/f_auto,u_9ddf04c7-2a9a-4d76-add1-d15af8f0263d,c_scale,fl_relative,w_1.0,h_1.0,fl_layer_apply/7704fd53-429e-430d-9bac-ab2a563f87fb/U+NK+CLUB+CAP+U+FB+PREM+L.png"
              alt="Gorra Nike Club Premier frontal"
              loading="eager"
            />
            <div class="absolute inset-0 mask-fade-bottom"></div>
          </div>

          <!-- Floating badge -->
          <div
            class="absolute -bottom-4 -left-4 bg-ink border border-white/8 p-4 flex items-center gap-3 anim-slide-up"
            style="animation-delay: 0.55s"
          >
            <div class="text-ember font-display text-[1.5rem] lg:text-[2rem] font-bold leading-none">100%</div>
            <div class="text-[0.55rem] font-mono uppercase tracking-[0.15em] text-smoke leading-tight">
              Hecho<br />en Perú
            </div>
          </div>

          <!-- Secondary gorra image -->
          <div
            class="absolute -top-4 -right-4 w-32 h-32 lg:w-40 lg:h-40 overflow-hidden border-2 border-ink bg-iron anim-scale-in"
            style="animation-delay: 0.35s"
          >
            <img
              class="w-full h-full object-contain p-1"
              src="https://static.nike.com/a/images/t_web_pw_592_v2/f_auto/u_9ddf04c7-2a9a-4d76-add1-d15af8f0263d,c_scale,fl_relative,w_1.0,h_1.0,fl_layer_apply/0e4e3c9d-f390-48b0-9102-8551f7a5a0c0/U+NK+CLUB+CAP+U+FB+PREM+L.png"
              alt="Gorra Nike Club Premier"
              loading="lazy"
            />
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- Scroll indicator -->
  <div class="absolute bottom-8 left-1/2 -translate-x-1/2 flex flex-col items-center gap-2 anim-fade-in scroll-float" style="animation-delay: 0.9s">
    <span class="text-[0.5rem] font-mono uppercase tracking-[0.25em] text-smoke/30">Desplázate</span>
    <span class="w-[1px] h-8 bg-gradient-to-b from-ember/60 to-transparent"></span>
  </div>
</section>
