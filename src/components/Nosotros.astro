<section id="nosotros" class="relative py-section overflow-hidden" style="background: var(--iron)">
  <div class="section-number" style="color: var(--lead)">03</div>

  <div class="mx-auto px-gutter relative z-10" style="max-width: 1400px">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-16 items-center">
      <!-- Text block -->
      <div class="lg:col-span-6">
        <span class="section-label block mb-4 reveal" style="color: var(--ember)">Quiénes somos</span>

        <div class="reveal-left">
          <p class="text-body-lg leading-relaxed mt-0" style="color: var(--soot)">
            <strong style="color: var(--lead)">Erick</strong> no es una marca de ropa. Somos
            una fábrica obsesionada con un solo producto: la gorra. Desde la
            selección del gramaje de la tela hasta el broche final.
          </p>
        </div>

        <p class="text-body-md leading-relaxed mt-4 reveal-left" style="transition-delay: 0.1s; color: var(--smoke)">
          Producimos para marcas de ropa, agencias, emprendedores y negocios
          locales. No tercerizamos: todo se hace en nuestro taller con
          maquinaria de última generación.
        </p>

        <!-- Big stats — AI Report inspired -->
        <div class="grid grid-cols-3 gap-6 mt-10 reveal-left" style="transition-delay: 0.2s">
          <div>
            <div class="stat-number leading-none" style="color: var(--ember)"><span class="counter" data-target="120">0</span></div>
            <div class="accent-line mt-2 mb-2" style="background: var(--ember)"></div>
            <p class="text-[0.6rem] font-mono uppercase tracking-[0.15em] m-0" style="color: var(--smoke)">Modelos diseñados</p>
          </div>
          <div>
            <div class="stat-number leading-none" style="color: var(--ember)"><span class="counter" data-target="500">0</span></div>
            <div class="accent-line mt-2 mb-2" style="background: var(--ember)"></div>
            <p class="text-[0.6rem] font-mono uppercase tracking-[0.15em] m-0" style="color: var(--smoke)">Marcas activas</p>
          </div>
          <div>
            <div class="stat-number leading-none" style="color: var(--ember)"><span class="counter" data-target="12">0</span></div>
            <div class="accent-line mt-2 mb-2" style="background: var(--ember)"></div>
            <p class="text-[0.6rem] font-mono uppercase tracking-[0.15em] m-0" style="color: var(--smoke)">Países destino</p>
          </div>
        </div>
      </div>

      <!-- Visual glass bento -->
      <div class="lg:col-span-6 reveal-right">
        <div class="bento-glass">
          <div class="relative overflow-hidden">
            <video class="w-full h-[400px] lg:h-[500px] object-cover" autoplay loop muted playsinline poster="https://images.unsplash.com/photo-1558618666-fcd25c85f82e?w=700&q=80">
              <source src="https://videos.pexels.com/video-files/31359194/13382176_1920_1080_50fps.mp4" type="video/mp4" />
            </video>
            <div class="absolute inset-0" style="background: linear-gradient(to top right, color-mix(in srgb, var(--ink) 60%, transparent), transparent);"></div>
          </div>
          <div class="p-5 flex items-center gap-4" style="border-top: 1px solid var(--glass-border)">
            <div class="w-12 h-12 flex items-center justify-center shrink-0 rounded-xl" style="background: var(--ember); color: white;">
              <span class="material-symbols-outlined">verified</span>
            </div>
            <div>
              <p class="text-[0.8rem] font-semibold m-0" style="color: var(--lead)">Control de calidad unitario</p>
              <p class="text-[0.7rem] m-0 mt-0.5" style="color: var(--smoke)">Cada gorra se inspecciona antes de enviarse</p>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>