<!-- Contact / Quote Form -->
<section id="contacto" class="bg-erick-gray">
  <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8 py-16 md:py-24">
    <div class="text-center mb-12">
      <p class="text-[10px] sm:text-xs font-semibold tracking-[0.2em] uppercase text-gray-400 mb-4">Cotizaciones</p>
      <h2 class="text-2xl sm:text-3xl md:text-4xl font-black tracking-tight uppercase">
        Solicita tu Presupuesto
      </h2>
      <p class="mt-4 text-sm text-gray-500 max-w-md mx-auto">
        Cuéntanos sobre tu proyecto y te responderemos en menos de 24 horas.
      </p>
    </div>

    <form id="quote-form" class="bg-white p-8 md:p-12 border border-gray-100" onsubmit="handleFormSubmit(event)">
      <div class="grid md:grid-cols-2 gap-6">
        <div>
          <label class="block text-[10px] font-bold tracking-widest uppercase text-gray-400 mb-2">Nombre *</label>
          <input type="text" name="nombre" required class="form-input w-full border border-gray-200 px-4 py-3 text-sm bg-transparent transition-all duration-300" placeholder="Tu nombre">
        </div>
        <div>
          <label class="block text-[10px] font-bold tracking-widest uppercase text-gray-400 mb-2">Empresa / Marca</label>
          <input type="text" name="empresa" class="form-input w-full border border-gray-200 px-4 py-3 text-sm bg-transparent transition-all duration-300" placeholder="Nombre de tu marca">
        </div>
        <div>
          <label class="block text-[10px] font-bold tracking-widest uppercase text-gray-400 mb-2">Correo Electrónico *</label>
          <input type="email" name="email" required class="form-input w-full border border-gray-200 px-4 py-3 text-sm bg-transparent transition-all duration-300" placeholder="correo@ejemplo.com">
        </div>
        <div>
          <label class="block text-[10px] font-bold tracking-widest uppercase text-gray-400 mb-2">Teléfono</label>
          <input type="tel" name="telefono" class="form-input w-full border border-gray-200 px-4 py-3 text-sm bg-transparent transition-all duration-300" placeholder="+51 919 599 132">
        </div>
        <div>
          <label class="block text-[10px] font-bold tracking-widest uppercase text-gray-400 mb-2">Tipo de Producto *</label>
          <select name="tipo" required class="form-input w-full border border-gray-200 px-4 py-3 text-sm bg-transparent transition-all duration-300 cursor-pointer">
            <option value="" disabled selected>Seleccionar</option>
            <option>Trucker</option>
            <option>Snapback</option>
            <option>Dad Hat</option>
            <option>Suede / Gamuza</option>
            <option>Personalizado a medida</option>
          </select>
        </div>
        <div>
          <label class="block text-[10px] font-bold tracking-widest uppercase text-gray-400 mb-2">Cantidad Estimada *</label>
          <select name="cantidad" required class="form-input w-full border border-gray-200 px-4 py-3 text-sm bg-transparent transition-all duration-300 cursor-pointer">
            <option value="" disabled selected>Seleccionar</option>
            <option>30 - 50 unidades</option>
            <option>50 - 100 unidades</option>
            <option>100 - 300 unidades</option>
            <option>300 - 500 unidades</option>
            <option>500+ unidades</option>
          </select>
        </div>
      </div>
      <div class="mt-6">
        <label class="block text-[10px] font-bold tracking-widest uppercase text-gray-400 mb-2">Mensaje / Detalles del Pedido</label>
        <textarea name="mensaje" rows="4" class="form-input w-full border border-gray-200 px-4 py-3 text-sm bg-transparent transition-all duration-300 resize-none" placeholder="Describe tu proyecto, colores, acabados, bordados, etc."></textarea>
      </div>
      <div class="mt-8">
        <button type="submit" class="btn-primary w-full bg-erick-black text-white text-xs font-semibold tracking-widest uppercase px-8 py-4 md:w-auto md:px-12">
          Enviar Solicitud
        </button>
      </div>
      <div id="form-success" class="hidden mt-6 bg-emerald-50 border border-emerald-200 p-4 text-center">
        <p class="text-sm font-semibold text-emerald-700">Solicitud enviada correctamente!</p>
        <p class="text-xs text-emerald-600 mt-1">Nos pondremos en contacto contigo pronto.</p>
      </div>
    </form>
  </div>
</section>