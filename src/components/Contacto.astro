<section id="contacto" class="relative py-section overflow-hidden" style="background: var(--ink)">
  <div class="section-number flipped" style="color: var(--ember); opacity: 0.06">04</div>
  <div class="absolute bottom-0 right-0 w-[400px] h-[400px] rounded-full" style="background: var(--ember); opacity: 0.03; filter: blur(80px);"></div>

  <div class="relative z-10 mx-auto px-gutter" style="max-width: 1200px">
    <div class="max-w-2xl mb-16 lg:mb-20 reveal">
      <span class="section-label block mb-3" style="color: var(--ember)">Cotización</span>
      <h2 class="font-display uppercase leading-[0.92] m-0" style="color: var(--lead); font-size: clamp(2.5rem, 5vw, 4.5rem)">
        Cuéntanos tu proyecto y recibe un presupuesto en 24h
      </h2>
    </div>

    <div class="grid grid-cols-1 lg:grid-cols-5 gap-8">
      <!-- Info cards -->
      <div class="lg:col-span-2 reveal-left space-y-4">
        <div class="glass-card-static p-5 flex items-start gap-4">
          <span class="material-symbols-outlined text-xl mt-0.5" style="color: var(--ember)">call</span>
          <div>
            <p class="text-[0.6rem] font-mono uppercase tracking-[0.15em] m-0 mb-1" style="color: var(--smoke)">Línea directa</p>
            <p class="text-[0.95rem] font-medium m-0" style="color: var(--lead)">+51 123 456 789</p>
          </div>
        </div>
        <div class="glass-card-static p-5 flex items-start gap-4">
          <span class="material-symbols-outlined text-xl mt-0.5" style="color: var(--ember)">mail</span>
          <div>
            <p class="text-[0.6rem] font-mono uppercase tracking-[0.15em] m-0 mb-1" style="color: var(--smoke)">Correo de producción</p>
            <p class="text-[0.95rem] font-medium m-0" style="color: var(--lead)">ventas@erickgorras.com</p>
          </div>
        </div>
        <div class="glass-card-static p-5 flex items-start gap-4">
          <span class="material-symbols-outlined text-xl mt-0.5" style="color: var(--ember)">schedule</span>
          <div>
            <p class="text-[0.6rem] font-mono uppercase tracking-[0.15em] m-0 mb-1" style="color: var(--smoke)">Tiempo de respuesta</p>
            <p class="text-[0.95rem] font-medium m-0" style="color: var(--lead)">&lt; 24 horas hábiles</p>
          </div>
        </div>
        <div class="glass-card-static p-5" style="background: color-mix(in srgb, var(--ember) 8%, var(--ink)); border-color: color-mix(in srgb, var(--ember) 20%, transparent);">
          <p class="text-[0.7rem] font-mono uppercase tracking-[0.1em] m-0 mb-2" style="color: var(--ember)">Lote mínimo</p>
          <p class="text-body-md m-0" style="color: var(--soot)">
            Producimos desde <strong style="color: var(--lead)">30 unidades</strong> por diseño.
          </p>
        </div>
      </div>

      <!-- Form -->
      <div class="lg:col-span-3 reveal-right">
        <form id="contact-form" class="glass-card p-6 lg:p-8 space-y-5" novalidate>
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-5">
            <div>
              <label for="nombre" class="text-[0.6rem] font-mono uppercase tracking-[0.15em] block mb-1.5" style="color: var(--smoke)">Nombre *</label>
              <input id="nombre" name="nombre" type="text" required
                class="w-full text-[0.9rem] px-4 py-2.5 outline-none transition-all duration-300 rounded-lg"
                style="background: var(--iron); border: 1px solid var(--slag); color: var(--lead);"
                onfocus="this.style.borderColor='var(--ember)'" onblur="this.style.borderColor='var(--slag)'"
                placeholder="Juan Pérez" />
            </div>
            <div>
              <label for="correo" class="text-[0.6rem] font-mono uppercase tracking-[0.15em] block mb-1.5" style="color: var(--smoke)">Correo *</label>
              <input id="correo" name="correo" type="email" required
                class="w-full text-[0.9rem] px-4 py-2.5 outline-none transition-all duration-300 rounded-lg"
                style="background: var(--iron); border: 1px solid var(--slag); color: var(--lead);"
                onfocus="this.style.borderColor='var(--ember)'" onblur="this.style.borderColor='var(--slag)'"
                placeholder="juan@marca.com" />
            </div>
          </div>
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-5">
            <div>
              <label for="telefono" class="text-[0.6rem] font-mono uppercase tracking-[0.15em] block mb-1.5" style="color: var(--smoke)">Teléfono *</label>
              <input id="telefono" name="telefono" type="tel" required
                class="w-full text-[0.9rem] px-4 py-2.5 outline-none transition-all duration-300 rounded-lg"
                style="background: var(--iron); border: 1px solid var(--slag); color: var(--lead);"
                onfocus="this.style.borderColor='var(--ember)'" onblur="this.style.borderColor='var(--slag)'"
                placeholder="+51 999 888 777" />
            </div>
            <div>
              <label for="tipo" class="text-[0.6rem] font-mono uppercase tracking-[0.15em] block mb-1.5" style="color: var(--smoke)">Tipo de gorra</label>
              <select id="tipo" name="tipo"
                class="w-full text-[0.9rem] px-4 py-2.5 outline-none transition-all duration-300 rounded-lg appearance-none cursor-pointer"
                style="background: var(--iron); border: 1px solid var(--slag); color: var(--lead);"
                onfocus="this.style.borderColor='var(--ember)'" onblur="this.style.borderColor='var(--slag)'">
                <option value="trucker" style="background: var(--ink); color: var(--lead)">Trucker Hat</option>
                <option value="snapback" style="background: var(--ink); color: var(--lead)">Snapback</option>
                <option value="dadhat" style="background: var(--ink); color: var(--lead)">Dad Hat</option>
                <option value="beanie" style="background: var(--ink); color: var(--lead)">Beanie</option>
              </select>
            </div>
          </div>
          <div>
            <label for="cantidad" class="text-[0.6rem] font-mono uppercase tracking-[0.15em] block mb-1.5" style="color: var(--smoke)">Cantidad estimada *</label>
            <input id="cantidad" name="cantidad" type="number" min="30" required
              class="w-full text-[0.9rem] px-4 py-2.5 outline-none transition-all duration-300 rounded-lg"
              style="background: var(--iron); border: 1px solid var(--slag); color: var(--lead);"
              onfocus="this.style.borderColor='var(--ember)'" onblur="this.style.borderColor='var(--slag)'"
              placeholder="50" />
          </div>
          <div>
            <label for="mensaje" class="text-[0.6rem] font-mono uppercase tracking-[0.15em] block mb-1.5" style="color: var(--smoke)">Cuéntanos sobre tu diseño</label>
            <textarea id="mensaje" name="mensaje" rows="4"
              class="w-full text-[0.9rem] px-4 py-2.5 outline-none transition-all duration-300 rounded-lg resize-none"
              style="background: var(--iron); border: 1px solid var(--slag); color: var(--lead);"
              onfocus="this.style.borderColor='var(--ember)'" onblur="this.style.borderColor='var(--slag)'"
              placeholder="Colores, logotipos, cantidades por modelo, fechas estimadas..."></textarea>
          </div>
          <div id="form-status" class="hidden text-body-md text-center p-3 rounded"></div>
          <button type="submit"
            class="w-full font-semibold text-[0.8rem] uppercase tracking-[0.1em] py-3.5 no-underline transition-all duration-300 cursor-pointer border-0 rounded-full"
            style="background: var(--ember); color: #FFFFFF;"
            onmouseover="this.style.background='var(--emberdark)'" onmouseout="this.style.background='var(--ember)'">
            Enviar solicitud
          </button>
        </form>
      </div>
    </div>
  </div>
</section>