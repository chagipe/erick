<!-- Sub-bar: Ordenar por -->
<div class="bg-white border-b border-neutral-200">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex items-center justify-end h-11">
      <div class="relative">
        <button id="sort-toggle" class="flex items-center gap-1.5 text-[10px] font-bold tracking-[0.12em] uppercase text-gray-600 hover:text-black transition-colors">
          Ordenar por
          <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="m19.5 8.25-7.5 7.5-7.5-7.5"/>
          </svg>
        </button>
        <div id="sort-dropdown" class="sort-dropdown">
          <button onclick="setSortText('Más recientes')">Más recientes</button>
          <button onclick="setSortText('Precio: menor a mayor')">Precio: menor a mayor</button>
          <button onclick="setSortText('Precio: mayor a menor')">Precio: mayor a menor</button>
          <button onclick="setSortText('Más vendidos')">Más vendidos</button>
        </div>
      </div>
    </div>
  </div>
</div>

<!-- Mobile Menu -->
<div id="mobile-menu" class="mobile-menu fixed inset-0 z-[100] bg-white">
  <div class="flex flex-col h-full">
    <div class="flex items-center justify-between px-4 h-16 border-b border-gray-100">
      <span class="text-2xl font-black tracking-widest">ERICK</span>
      <button id="menu-close" class="p-2" aria-label="Cerrar menú">
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="1.5">
          <path stroke-linecap="round" stroke-linejoin="round" d="M6 18 18 6M6 6l12 12"/>
        </svg>
      </button>
    </div>
    <div class="flex-1 flex flex-col justify-center items-center gap-8 px-8">
      <a href="#inicio" class="mobile-nav-link text-xl font-bold tracking-widest uppercase" onclick="closeMobileMenu()">Inicio</a>
      <a href="#coleccion" class="mobile-nav-link text-xl font-bold tracking-widest uppercase" onclick="closeMobileMenu()">Colección</a>
      <a href="#nosotros" class="mobile-nav-link text-xl font-bold tracking-widest uppercase" onclick="closeMobileMenu()">Nos Dedicamos A</a>
